{
  "name": "@haverstack/adapter-conformance",
  "version": "0.5.0",
  "description": "Runnable conformance suite for StackRecordAdapter/StackBlobAdapter implementers — the invariants docs/spec/adapters.md documents, as tests you point at your own adapter",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haverstack/core.git",
    "directory": "packages/adapter-conformance"
  },
  "license": "CC0-1.0",
  "keywords": [
    "haverstack",
    "conformance",
    "adapter",
    "storage",
    "testing"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "peerDependencies": {
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@haverstack/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
