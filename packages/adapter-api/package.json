{
  "name": "@haverstack/adapter-api",
  "version": "0.22.0",
  "description": "Remote server adapter for Haverstack",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haverstack/core.git",
    "directory": "packages/adapter-api"
  },
  "license": "CC0-1.0",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@haverstack/core": "workspace:^",
    "@haverstack/wire-types": "workspace:^"
  },
  "devDependencies": {
    "@haverstack/conformance-fixtures": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
